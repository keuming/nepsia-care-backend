# Chaîne de connexion Neon PostgreSQL (Settings > Environment Variables sur Vercel)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clé pour protéger la route d'initialisation /api/seed
ADMIN_SEED_KEY=nepsia_dev_secret_2026

# Clé secrète pour signer les jetons de connexion (JWT) — générez une valeur longue et aléatoire
# Exemple pour en générer une : openssl rand -hex 32
JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire
